# LinguaFlow environment configuration
# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored so your secrets are never committed.

# Primary LLM provider: Alibaba Cloud DashScope (Qwen)
# Get a key at https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name for the Qwen provider (optional).
# Leave blank to use the default. Examples:
#   qwen-turbo, qwen-plus, qwen-max, qwen3.7-flash-2026-07-15
QWEN_MODEL=qwen3.7-flash-2026-07-15

# Optional fallback provider (used automatically when Qwen hits a quota/rate limit)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model name for the OpenRouter fallback (optional).
# Leave blank to use the default. Examples:
#   google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Speech models (DashScope / Qwen) ---
# TTS voice id (optional). Leave blank for default Chinese voice. Examples:
#   sambert-zhide-v1 (中文), sambert-eva-v1 (English),
#   cosyvoice-v1, qwen-audio-3.0-tts-flash (multilingual)
QWEN_TTS_MODEL=sambert-zhide-v1

# STT / ASR model id (optional). Leave blank for default. Examples:
#   paraformer-v2, paraformer-realtime-v2, paraformer-v1
QWEN_STT_MODEL=paraformer-v2
