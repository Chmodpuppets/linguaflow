# 监听端口
PORT=8787
# 监听地址（默认只绑回环：公网不可直连，由同机 Caddy 反代。改成 0.0.0.0 才会对外暴露）
HOST=127.0.0.1
# 数据目录（SQLite 文件落在这里）
DATA_DIR=./data
# 允许的跨域来源（默认 *；生产建议收紧为你的前端域名）
CORS_ORIGIN=*
# 单个同步快照的最大体积（字节，默认 25MB）
MAX_BODY_BYTES=26214400
# 总注册人数上限（防公网被刷；到顶后拒绝新注册）
MAX_USERS=500
# 单 IP 每小时最多注册次数（内存限流，重启清零）
REGISTER_RATE_LIMIT=20
# 合规日志：管理员查询密钥（请求头 X-Admin-Key；留空则禁止查询，更安全）
ADMIN_KEY=
# 日志留存天数（备案要求 ≥180 天）
LOG_RETENTION_DAYS=180
# 单 IP 每小时最多上报日志条数（内存限流，重启清零）
LOG_RATE_LIMIT=500

# ==================== TTS 音频代理（开源版默认关闭）====================
# 这是一套「某个部署自己的 OSS」的能力，所以开源发行版**默认不启用**（TTS_PROXY_ENABLED=0，
# 此时 /tts/audio 直接返回 503）。
#
#   · 只想自用、不想折腾云端存储 → 保持 0，什么都不用往这里填。前端会自动退回
#     「浏览器直连 Qwen + 本地 IndexedDB 缓存」，功能不缺，只是不跨设备共享。
#   · 想启用 → 填**你自己的** OSS 凭证，再把 TTS_PROXY_ENABLED 改成 1。
#
# ⚠️ 绝不要填别人的 bucket / AccessKey。凭证只应存在于你这台服务器的 .env 里，
#    不要提交到 Git，也不要以任何方式写进前端代码或构建产物。
TTS_PROXY_ENABLED=0
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 对象前缀（改前缀 = 换一代缓存，旧对象留在 bucket 里需手动清）
OSS_TTS_PREFIX=tts/v1/
# 单条音频体积上限（字节，默认 5MB）
TTS_MAX_BYTES=5242880
# 允许中转到哪些域名抓音频（防 SSRF；默认只放行阿里云 OSS/CDN）
TTS_ALLOW_HOSTS=.aliyuncs.com
# 单 IP 每小时最多请求多少次音频（内存限流，重启清零）
TTS_RATE_LIMIT=1200
